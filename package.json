  "private": true,
  "description": "External Gladys Assistant integration for Mercedes-Benz cars (Mercedes me): battery, fuel, range, lock, openings, charge, climate, position, scenes and a dashboard widget.",
  "homepage": "https://github.com/William-De71/gladys-mercedes-benz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-mercedes-benz.git"
  },
